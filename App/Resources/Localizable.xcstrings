    "autobackup.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Once a week a copy is saved automatically to iCloud Drive → CarCare Log (last 5 files)." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Раз в неделю копия автоматически сохраняется в iCloud Drive → CarCare Log (последние 5 файлов)." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Раз на тиждень копія автоматично зберігається в iCloud Drive → CarCare Log (останні 5 файлів)." } }
      }
    },
    "autobackup.footerLocal" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "iCloud isn’t available, so copies go to Files → On My iPhone → CarCare Log. That doesn’t protect against losing the phone — export a copy now and then." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "iCloud недоступен, поэтому копии сохраняются в «Файлы» → «На iPhone» → CarCare Log. От потери телефона это не защищает — время от времени экспортируйте копию." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "iCloud недоступний, тому копії зберігаються у «Файли» → «На iPhone» → CarCare Log. Від втрати телефону це не захищає — час від часу експортуйте копію." } }
      }
    },
    "autobackup.last" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Last backup" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Последняя копия" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Остання копія" } }
